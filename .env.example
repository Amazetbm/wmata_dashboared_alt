# Root .env — read by docker-compose only.
# For local dev without Docker, use server/.env instead.
WMATA_API_KEY=your_api_key_here
MONGODB_URI=mongodb://mongo:27017/wmata_dashboard
PORT=3000

# ── Ask the Dashboard (LLM assistant) ────────────────────────────────────────
# Set LLM_PROVIDER + LLM_MODEL to enable the feature.
# Leave unset (or set ASSISTANT_ENABLED=false) to disable gracefully.

# LLM_PROVIDER: anthropic | openai | gemini | openai-compatible
# LLM_PROVIDER=anthropic

# LLM_MODEL is required — no silent default.
# LLM_MODEL=claude-sonnet-4-6          # Anthropic
# LLM_MODEL=gpt-4o                     # OpenAI
# LLM_MODEL=gemini-2.0-flash           # Gemini
# LLM_MODEL=llama3.2                   # Ollama (openai-compatible)

# LLM_API_KEY: required for cloud providers; leave empty for local servers (Ollama).
# LLM_API_KEY=sk-ant-...               # Anthropic
# LLM_API_KEY=sk-...                   # OpenAI
# LLM_API_KEY=AIza...                  # Gemini
# LLM_API_KEY=                         # Ollama (no key needed)

# LLM_BASE_URL: required for openai-compatible; optional override for others.
# LLM_BASE_URL=http://localhost:11434  # Ollama
# LLM_BASE_URL=https://api.anthropic.com   # Anthropic

# Optional tuning
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_MS=30000

# Set to false to disable the assistant even if LLM vars are configured.
# ASSISTANT_ENABLED=false
